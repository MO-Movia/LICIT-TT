{
  "name": "@modusoperandi/licit-tiptap",
  "version": "0.0.1",
  "subversion": "1",
  "description": "Rich text editor built with React and ProseMirror",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/LICIT-TT"
  },
  "style": "styles/styles.css",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./licit/src/index.d.js",
      "default": "./licit/src/index.js"
    },
    "./licit": {
      "types": "./licit/src/index.d.js",
      "default": "./licit/src/index.js"
    },
    "./core": {
      "types": "./core/src/index.d.js",
      "default": "./core/src/index.js"
    },
    "./commands": {
      "types": "./commands/src/index.d.js",
      "default": "./commands/src/index.js"
    },
    "./plugins/block-control": {
      "types": "./plugins/block-control/src/index.d.js",
      "default": "./plugins/block-control/src/index.js"
    },
    "./plugins/change-case": {
      "types": "./plugins/change-case/src/index.d.js",
      "default": "./plugins/change-case/src/index.js"
    },
    "./plugins/citation": {
      "types": "./plugins/citation/src/index.d.js",
      "default": "./plugins/citation/src/index.js"
    },
    "./plugins/copy-images": {
      "types": "./plugins/copy-images/src/index.d.js",
      "default": "./plugins/copy-images/src/index.js"
    },
    "./plugins/custom-styles": {
      "types": "./plugins/custom-styles/src/index.d.js",
      "default": "./plugins/custom-styles/src/index.js"
    },
    "./plugins/export-pdf": {
      "types": "./plugins/export-pdf/src/index.d.js",
      "default": "./plugins/export-pdf/src/index.js"
    },
    "./plugins/glossary": {
      "types": "./plugins/glossary/src/index.d.js",
      "default": "./plugins/glossary/src/index.js"
    },
    "./plugins/highlight": {
      "types": "./plugins/highlight/src/index.d.js",
      "default": "./plugins/highlight/src/index.js"
    },
    "./plugins/info-icon": {
      "types": "./plugins/info-icon/src/index.d.js",
      "default": "./plugins/info-icon/src/index.js"
    },
    "./plugins/multimedia": {
      "types": "./plugins/multimedia/src/index.d.js",
      "default": "./plugins/multimedia/src/index.js"
    },
    "./plugins/object-id": {
      "types": "./plugins/object-id/src/index.d.js",
      "default": "./plugins/object-id/src/index.js"
    },
    "./plugins/paste-json": {
      "types": "./plugins/paste-json/src/index.d.js",
      "default": "./plugins/paste-json/src/index.js"
    },
    "./plugins/vignette": {
      "types": "./plugins/vignette/src/index.d.js",
      "default": "./plugins/vignette/src/index.js"
    }
  },
  "scripts": {
    "update:modules": "git -C . submodule update --recursive --remote",
    "test": "jest --coverage",
    "build:bom": "npx @cyclonedx/cyclonedx-bom -o dist/bom.xml",
    "build:clean": "rm -rf dist/ && rm -f modusoperandi-licit-tiptap-*.*.*.tgz",
    "build:css": "mkdirp ./dist/styles && cp src/licit/src/styles/* dist/styles",
    "build:fonts": "mkdirp ./dist/fonts && cp -r fonts/* dist/fonts",
    "build:assets": "mkdirp ./dist/assets && cp -r assets/* dist/assets",
    "build:esm": "node build.mjs",
    "build:esbuild:test": "tsc -p tsconfig.prod.json --emitDeclarationOnly --declaration",
    "build:ts": "tsc -p tsconfig.prod.json && npx tsc-alias -p tsconfig.json",
    "ci:build": "npm run build:clean && npm run build:ts && npm run build:css && npm run build:fonts && npm run build:assets && npx copyfiles package.json README.md LICENSE dist",
    "pack:build": "npm run ci:build && cd dist && npm pack --pack-destination ../.",
    "webpack": "webpack",
    "start": "cross-env NODE_ENV=development webpack serve --config tools/webpack/webpack.config.dev.js",
    "build:bin": "cross-env NODE_ENV=production webpack --config tools/webpack/webpack.config.prod.js",
    "serve": "cross-env NODE_ENV=production webpack --config tools/webpack/webpack.config.prod.js && cross-env serve dist/",
    "lint:ts": "eslint src --fix",
    "lint:css": "stylelint \"**/*.css\" --fix",
    "lint": "npm run lint:ts && npm run lint:css",
    "prebuild:style-service-docker": "node utils/build_customstyle_server.js",
    "build:style-service-docker": "docker build . -f style-service.Dockerfile -t style-service:latest",
    "verify": "npm run lint -- --fix && npm run ci:build && npm run test:coverage && echo 'All Tests Passed!'"
  },
  "peerDependencies": {
    "@modusoperandi/color-picker": "^1.0.7",
    "@tiptap/core": "^2.9.1",
    "@tiptap/extension-collaboration": "^2.1.0",
    "@tiptap/extension-collaboration-cursor": "^2.1.0",
    "@tiptap/extension-highlight": "^2.1.0",
    "@tiptap/extension-link": "^2.1.0",
    "@tiptap/extension-list-item": "^2.1.0",
    "@tiptap/extension-subscript": "^2.1.0",
    "@tiptap/extension-superscript": "^2.1.0",
    "@tiptap/extension-table": "^2.1.0",
    "@tiptap/extension-table-cell": "^2.1.0",
    "@tiptap/extension-table-header": "^2.1.0",
    "@tiptap/extension-table-row": "^2.1.0",
    "@tiptap/extension-task-item": "^2.1.0",
    "@tiptap/extension-task-list": "^2.1.0",
    "@tiptap/extension-text-align": "^2.1.0",
    "@tiptap/extension-underline": "^2.1.0",
    "@tiptap/react": "^2.0.0",
    "@tiptap/starter-kit": "^2.1.0",
    "axios": "^1.13.2",
    "browserkeymap": "2.0.2",
    "classnames": "2.2.6",
    "color": "^3.1.2",
    "nullthrows": "1.1.1",
    "pagedjs": "^0.4.3",
    "prop-types": "^15.8.1",
    "prosemirror-commands": "^1.0.0",
    "prosemirror-dev-tools": "^4.2.0",
    "prosemirror-history": "^1.0.0",
    "prosemirror-inputrules": "^1.1.3",
    "prosemirror-keymap": "^1.0.0",
    "prosemirror-menu": "^1.0.0",
    "prosemirror-model": "^1.0.0",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.2.4",
    "prosemirror-state": "^1.0.0",
    "prosemirror-tables": "^1.2.5",
    "prosemirror-transform": "^1.0.0",
    "prosemirror-utils": "^1.0.0-0",
    "prosemirror-view": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-image-crop": "^11.0.10",
    "resize-observer-polyfill": "1.5.1",
    "smooth-scroll-into-view-if-needed": "1.1.28",
    "tippy.js": "^6.3.7",
    "url": "^0.11.3",
    "uuid": "11.0.0",
    "y-indexeddb": "^9.0.6",
    "y-webrtc": "^10.2.3",
    "yjs": "^13.5.24"
  },
  "devDependencies": {
    "@modusoperandi/eslint-config": "^3.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.11.5",
    "@types/prosemirror-state": "^1.2.8",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5",
    "jest-json": "^2.0.0",
    "jest-junit": "^16.0.0",
    "jest-prosemirror": "^3.0.1",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.1.4",
    "mini-css-extract-plugin": "^2.6.1",
    "mkdirp": "^1.0.4",
    "prettier": "^3.6.2",
    "prosemirror-test-builder": "^1.1.1",
    "serve": "^14.0.1",
    "stylelint": "^16.23.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-prettier": "^5.0.3",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-transform-paths": "^3.5.5"
  }
}